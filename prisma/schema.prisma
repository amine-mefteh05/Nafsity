generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  PSYCHOLOGIST
  ADMIN
}
enum AccountStatus {
  ACTIVE
  SUSPENDED
}
enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}
enum SubStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}
enum Frequency {
  DAILY
  WEEKLY
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  firstName String
  lastName String
  dateOfBirth DateTime? @db.Date
  phone String?
  governorate String?
  role Role @default(USER)
  status AccountStatus @default(ACTIVE)
  language String @default("fr")
  emailVerifiedAt DateTime?
  emailVerifyToken String? @unique
  resetToken String? @unique
  resetExpires DateTime?
  consentAt DateTime?
  notifPrefs Json?
  isDemo Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  psychologist Psychologist?
  subscriptions Subscription[]
  payments Payment[]
  appointments Appointment[]
  moods MoodEntry[]
  journals JournalEntry[]
  exerciseCompletions ExerciseCompletion[]
  userChallenges UserChallenge[]
  notifications Notification[]
  reviews Review[]
  favorites FavoriteInspiration[]
  relaxSessions RelaxationSession[]
  aiConversations AIConversation[]
  auditLogs AdminAuditLog[]
  @@index([role, status])
}

model Specialization {
  id String @id @default(cuid())
  key String @unique
  nameFr String
  nameEn String
  nameAr String
  psychologists Psychologist[]
}

model Psychologist {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String @default("Psychologue")
  bio String
  experienceYears Int @default(0)
  languages String[]
  governorate String
  verified Boolean @default(false)
  verifiedAt DateTime?
  active Boolean @default(true)
  isDemo Boolean @default(false)
  photoUrl String?
  specializations Specialization[]
  qualifications PsychologistQualification[]
  availability Availability[]
  blocks AvailabilitySlot[]
  appointments Appointment[]
  reviews Review[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([governorate, active])
}

model PsychologistQualification {
  id String @id @default(cuid())
  psychologistId String
  psychologist Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  title String
  institution String
  year Int?
  verified Boolean @default(false)
  @@index([psychologistId])
}

model SubscriptionPlan {
  id String @id @default(cuid())
  code String @unique
  name String
  priceTnd Int
  sessionsPerMonth Int
  features String[]
  priorityRequests Boolean @default(false)
  active Boolean @default(true)
  sortOrder Int @default(0)
  subscriptions Subscription[]
  payments Payment[]
}

model Subscription {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String
  plan SubscriptionPlan @relation(fields: [planId], references: [id])
  status SubStatus @default(ACTIVE)
  startsAt DateTime
  endsAt DateTime
  sessionsUsed Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payments Payment[]
  appointments Appointment[]
  @@index([userId, status, endsAt])
}

model Payment {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String
  plan SubscriptionPlan @relation(fields: [planId], references: [id])
  subscriptionId String?
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  amountTnd Int
  method String
  status PaymentStatus @default(PENDING)
  reference String @unique
  isSimulated Boolean @default(true)
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model Appointment {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  psychologistId String
  psychologist Psychologist @relation(fields: [psychologistId], references: [id])
  subscriptionId String?
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  startsAt DateTime
  endsAt DateTime
  status AppointmentStatus @default(PENDING)
  priority Boolean @default(false)
  sessionDeducted Boolean @default(true)
  rescheduleRequested Boolean @default(false)
  cancelReason String?
  // Visible ONLY to the psychologist who owns the appointment. Never shown to admins.
  consultationNotes String?
  videoRoomId String? // reserved for future video consultations
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  review Review?
  @@index([userId, startsAt])
  @@index([psychologistId, startsAt])
}

model Availability {
  id String @id @default(cuid())
  psychologistId String
  psychologist Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  weekday Int // 0=Sunday..6=Saturday
  startMinute Int
  endMinute Int
  slotMinutes Int @default(45)
  breakStartMinute Int?
  breakEndMinute Int?
  @@unique([psychologistId, weekday])
}

// Blocked periods (holidays, leave, unavailable dates)
model AvailabilitySlot {
  id String @id @default(cuid())
  psychologistId String
  psychologist Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  startsAt DateTime
  endsAt DateTime
  reason String?
  @@index([psychologistId, startsAt])
}

model MoodEntry {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood String
  intensity Int
  note String?
  date DateTime @db.Date
  createdAt DateTime @default(now())
  @@unique([userId, date])
}

model JournalEntry {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String
  content String
  mood String?
  emotions String[]
  tags String[]
  isPrivate Boolean @default(true)
  isDraft Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, createdAt])
}

model Exercise {
  id String @id @default(cuid())
  slug String @unique
  title String
  description String
  category String
  durationMin Int
  difficulty String
  instructions String[]
  active Boolean @default(true)
  completions ExerciseCompletion[]
}

model ExerciseCompletion {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())
  @@index([userId, completedAt])
}

model Challenge {
  id String @id @default(cuid())
  title String
  description String
  frequency Frequency @default(DAILY)
  active Boolean @default(true)
  userChallenges UserChallenge[]
}

model UserChallenge {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  completedOn DateTime @db.Date
  @@unique([userId, challengeId, completedOn])
  @@index([userId, completedOn])
}

model Notification {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type String
  title String
  body String
  read Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([userId, read, createdAt])
}

model Review {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  psychologistId String
  psychologist Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  appointmentId String @unique
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  rating Int
  comment String?
  createdAt DateTime @default(now())
}

model InspirationMessage {
  id String @id @default(cuid())
  text String
  category String
  kind String @default("message") // message | affirmation | reflection | recommendation
  publishAt DateTime @default(now())
  active Boolean @default(true)
  favorites FavoriteInspiration[]
}

model FavoriteInspiration {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String
  message InspirationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, messageId])
}

model RelaxationSession {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type String
  durationSec Int
  completedAt DateTime @default(now())
  @@index([userId, completedAt])
}

model AIConversation {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  messages AIMessage[]
}

model AIMessage {
  id String @id @default(cuid())
  conversationId String
  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role String
  content String
  createdAt DateTime @default(now())
  @@index([conversationId, createdAt])
}

model AdminAuditLog {
  id String @id @default(cuid())
  adminId String
  admin User @relation(fields: [adminId], references: [id])
  action String
  target String?
  detail String?
  createdAt DateTime @default(now())
  @@index([createdAt])
}
